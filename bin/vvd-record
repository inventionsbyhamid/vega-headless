#!/usr/bin/env python3
"""Record the virtual device at 1080p with its sound through the emulator's own recorder.
Grabbing the X display stalls while the device draws, so this asks the emulator instead.
usage: vvd-record <seconds> <out.webm>"""
import os, socket, sys, time

seconds, out = float(sys.argv[1]), os.path.abspath(sys.argv[2])


def console(command):
    s = socket.create_connection(("127.0.0.1", int(os.environ.get("VVD_CONSOLE_PORT", "5554"))), timeout=10)
    time.sleep(0.4); s.recv(4096)
    token = open(os.path.expanduser("~/.emulator_console_auth_token")).read().strip()
    s.sendall(f"auth {token}\r\n".encode()); time.sleep(0.4); s.recv(4096)
    s.sendall(f"{command}\r\n".encode()); time.sleep(0.5)
    s.recv(4096)
    s.close()


console(f"screenrecord start --time-limit {int(seconds) + 5} {out}")
time.sleep(seconds)
console("screenrecord stop")
time.sleep(3)
print(out)
